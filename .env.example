# PostgreSQL Configuration
POSTGRES_DB=snp_depot_db
POSTGRES_USER=postgres
# Supply a private local password before running compose.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=
JWT_ISSUER=SnpDepotManagement
JWT_AUDIENCE=SnpDepotManagementUsers

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:4200

# Depot
DEPOT_NAME=SNP Depot
DEPOT_TIMEZONE=Asia/Ho_Chi_Minh

# Seed
ADMIN_TENANT_ID=DEPOT-A
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SEED_DEMO_DATA=false
# Required only for Development demo users; never commit a real password.
SEED_USER_PASSWORD=
API_PORT=5000
