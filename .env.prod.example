# Copy to .env.prod (ignored) and replace every REPLACE_ placeholder.
POSTGRES_DB=REPLACE_DATABASE_NAME
POSTGRES_USER=REPLACE_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_DATABASE_PASSWORD
Jwt__Secret=REPLACE_WITH_CRYPTOGRAPHIC_BASE64_SECRET_AT_LEAST_32_BYTES
Jwt__Issuer=REPLACE_JWT_ISSUER
Jwt__Audience=REPLACE_JWT_AUDIENCE
Admin__TenantId=REPLACE_DEPOT_ID
Admin__UserName=REPLACE_BOOTSTRAP_ADMIN_NAME
Admin__Password=REPLACE_WITH_GENERATED_ADMIN_PASSWORD
Cors__AllowedOrigins__0=https://REPLACE_FRONTEND_DOMAIN
Redis__Required=true
API_PORT=8080
MIGRATION_MODE=fresh
BACKUP_RETENTION=7
# Optional exact IP of your TLS reverse proxy; leave empty for direct local HTTP.
ReverseProxy__TrustedProxy=
BACKUP_HOST_DIR=./backups
MIGRATION_INPUT_DIR=./migration-input
